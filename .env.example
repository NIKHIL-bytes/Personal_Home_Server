# Copy this file to .env and fill in real values.
# Never commit the real .env file.

APP_NAME=Home Server
APP_ENV=production

# Set true only when the site is served over HTTPS.
# Keep false for the initial LAN HTTP deployment.
COOKIE_SECURE=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret

DATABASE_PATH=/opt/home-server/data/database/server.db
USER_STORAGE_PATH=/opt/home-server/data/users
SHARED_STORAGE_PATH=/opt/home-server/data/shared
MEDIA_STORAGE_PATH=/opt/home-server/data/media
THUMBNAIL_PATH=/opt/home-server/data/thumbnails

# 5 GB default max upload size, in bytes
MAX_UPLOAD_SIZE=5368709120

# Session length in hours (default 7 days)
SESSION_TIMEOUT_HOURS=168

# Default quota for newly created users, in bytes (default 20 GB)
DEFAULT_USER_QUOTA_BYTES=21474836480
